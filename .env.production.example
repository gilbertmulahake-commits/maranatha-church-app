# ==============================================================================
# Maranatha Church App - PRODUCTION Environment Variables
# ==============================================================================
# ⚠️ DO NOT COMMIT THIS FILE TO GITHUB. ⚠️
# These values are set in the Vercel Dashboard (Project Settings -> Environment Variables).
# This file is only for local production testing (e.g., `npm run build && npm start`).

# DATABASE (Supabase Production)
DATABASE_URL=

# AUTHENTICATION (Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SMS INTEGRATION (Africa's Talking — Sandbox for UAT, Live for Production)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_URL=https://api.sandbox.africastalking.com/version1/messaging

# BANK INTEGRATIONS (Live)
KCB_SANDBOX_URL=
EQUITY_SANDBOX_URL=
BANK_ADAPTER_MODE=sandbox

# APP CONFIGURATION
NODE_ENV=production