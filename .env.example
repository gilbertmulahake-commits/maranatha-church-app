# ==============================================================================
# Maranatha Church App - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` (for local dev) or `.env.production` (for production)
# and fill in the actual secret values. NEVER commit `.env` or `.env.production`.

# ------------------------------------------------------------------------------
# DATABASE (Supabase)
# ------------------------------------------------------------------------------
# The pooled connection string for Prisma (Supavisor).
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ------------------------------------------------------------------------------
# AUTHENTICATION (Supabase Auth)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# SMS INTEGRATION (Africa's Talking)
# ------------------------------------------------------------------------------
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# Override for sandbox testing. Leave blank for production.
# Sandbox URL: https://api.sandbox.africastalking.com/version1/messaging
AFRICASTALKING_API_URL=

# ------------------------------------------------------------------------------
# BANK INTEGRATIONS (Sandbox / Mock Mode)
# ------------------------------------------------------------------------------
# These URLs will be used by the Bank Adapter Engine (Phase 3).
# For now, they point to the sandbox or mock endpoints.
KCB_SANDBOX_URL=
EQUITY_SANDBOX_URL=

# ------------------------------------------------------------------------------
# PAYMENT INTENTS (Unit 19 — Guided Payment Flow)
# ------------------------------------------------------------------------------
# Master switch for STK Push initiation. 'disabled' hides the STK option in the
# wizard and leaves only the manual paybill instructions.
# Values: 'sandbox' | 'live' | 'disabled'
PAYMENT_PROVIDER_MODE=sandbox

# Manual channel paybill — displayed in the wizard's M-Pesa instructions.
# The church's Church ID (e.g. CH001) is the account reference.
NEXT_PUBLIC_MPESA_PAYBILL_NUMBER=

# KCB Buni (STK Push initiation) — sandbox uses the shared shortcode 522522.
# Register at https://sandbox.buni.kcbgroup.com to obtain the consumer key/secret.
KCB_BUNI_CONSUMER_KEY=
KCB_BUNI_CONSUMER_SECRET=
KCB_BUNI_ORG_SHORTCODE=522522
NEXT_PUBLIC_KCB_PAYBILL_NUMBER=522522
# Comma-separated list of allowed callback IPs. Empty = warn-only (sandbox).
KCB_CALLBACK_ALLOWED_IPS=

# Equity Jenga (STK Push initiation + IPN confirmation).
# Register at https://v3.jengahq.io/registration, obtain merchant code + API key.
# JENGA_PRIVATE_KEY_PEM must be the PEM-formatted RSA key whose public half is
# uploaded to the JengaHQ console. Never commit the actual value.
JENGA_MERCHANT_CODE=
JENGA_API_KEY=
JENGA_CONSUMER_SECRET=
JENGA_PRIVATE_KEY_PEM=
NEXT_PUBLIC_EQUITY_PAYBILL_NUMBER=

# ------------------------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------------------------
# Toggle between 'mock', 'sandbox', and 'live' for bank integrations.
BANK_ADAPTER_MODE=mock
NODE_ENV=development