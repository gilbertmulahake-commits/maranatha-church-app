# ==============================================================================
# Maranatha Church App - Environment Variables Template
# ==============================================================================
# Copy this file to `.env` (for local dev) or `.env.production` (for production)
# and fill in the actual secret values. NEVER commit `.env` or `.env.production`.

# ------------------------------------------------------------------------------
# DATABASE (Supabase)
# ------------------------------------------------------------------------------
# The pooled connection string for Prisma (Supavisor).
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres
DATABASE_URL=

# ------------------------------------------------------------------------------
# AUTHENTICATION (Supabase Auth)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# SMS INTEGRATION (Africa's Talking)
# ------------------------------------------------------------------------------
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# Override for sandbox testing. Leave blank for production.
# Sandbox URL: https://api.sandbox.africastalking.com/version1/messaging
AFRICASTALKING_API_URL=

# ------------------------------------------------------------------------------
# BANK INTEGRATIONS (Sandbox / Mock Mode)
# ------------------------------------------------------------------------------
# These URLs will be used by the Bank Adapter Engine (Phase 3).
# For now, they point to the sandbox or mock endpoints.
KCB_SANDBOX_URL=
EQUITY_SANDBOX_URL=

# ------------------------------------------------------------------------------
# APP CONFIGURATION
# ------------------------------------------------------------------------------
# Toggle between 'mock', 'sandbox', and 'live' for bank integrations.
BANK_ADAPTER_MODE=mock
NODE_ENV=development